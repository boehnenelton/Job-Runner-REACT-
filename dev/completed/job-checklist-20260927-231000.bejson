{
  "Format": "BEJSON",
  "Format_Version": "104a",
  "Format_Creator": "Elton Boehnen",
  "Schema_Name": "Job Schema",
  "Schema_Version": "1.0",
  "Schema_Description": "Checklist governing the integration of the sequential chapter book writing template and context feeding mechanics.",
  "Job_Goal": "Incorporate a high-fidelity book writing template where each chapter is generated one task at a time, ensuring that the previously completed chapter's full text and total plan scope are recursively fed to subsequent tasks as context.",
  "Goal_Rules": "Strict compliance with Elton Boehnen core BEJSON standards, Tri-Color palette, 1:1 parity between TypeScript and JavaScript mirrors, and verified lint compliance.",
  "Job_Type": "creative",
  "Job_Subtype": "novel_evolution",
  "Contextualize_Plan": true,
  "Contextualize_Last": true,
  "Job_Complete": true,
  "Creation_Date": "2026-09-27",
  "Completion_Date": "2026-09-27",
  "Records_Type": [
    "JobTask"
  ],
  "Fields": [
    { "name": "task_id", "type": "string" },
