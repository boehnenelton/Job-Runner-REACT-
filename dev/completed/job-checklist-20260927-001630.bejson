  "Schema_Name": "Job Schema",
  "Schema_Version": "1.0",
  "Schema_Description": "Custom job schema for the NewAgent task creation and tracking system, managing individual task states and optional auditing.",
  "Job_Goal": "Rebuild JobMaker & Job Runner from Flask to TypeScript with full backward compatibility, core TS libraries integration, new templates, and vanilla JS mirror.",
